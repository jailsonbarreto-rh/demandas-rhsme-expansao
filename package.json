{
  "name": "demandas-rhsme",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "bootstrap:supabase": "node --env-file=.env.bootstrap scripts/bootstrap-supabase.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm audit --audit-level=high && npm test && npm run build",
    "check:full": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fortawesome/fontawesome-free": "7.3.0",
    "@supabase/supabase-js": "2.110.5",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x"
  }
}
