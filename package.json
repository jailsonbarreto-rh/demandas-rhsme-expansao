{
  "name": "demandas-rhsme",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "bootstrap:supabase": "node --env-file=.env.bootstrap scripts/bootstrap-supabase.mjs",
    "types:supabase": "supabase gen types typescript --project-id kdhekkzwcokfrpcrsllr --schema public > src/lib/database.types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm audit --audit-level=high && npm test && npm run build",
    "check:full": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "29.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "4.1.10"
  }
}
