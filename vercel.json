{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm test -- VisaoGeral.semanticLabels ResponsibleSelection DeadlineControl UserFacingInformationAudit",
  "outputDirectory": ".",
  "git": { "deploymentEnabled": true },
  "rewrites": [
    { "source": "/demandas", "destination": "/index.html" },
    { "source": "/demandas/:path*", "destination": "/index.html" },
    { "source": "/minhas-demandas", "destination": "/index.html" },
    { "source": "/minhas-demandas/:path*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
