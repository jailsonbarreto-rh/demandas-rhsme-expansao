{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run check:docs",
  "git": {
    "deploymentEnabled": true
  },
  "rewrites": [
    {
      "source": "/demandas",
      "destination": "/index.html"
    },
    {
      "source": "/demandas/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/minhas-demandas",
      "destination": "/index.html"
    },
    {
      "source": "/minhas-demandas/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    }
  ]
}