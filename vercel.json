{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm test -- UserFacingInformationAudit userFacingErrors historyPresentation HistoryPresentation AdminPanel ModalDateValidation AuthPanel supabaseProfilesService",
  "outputDirectory": ".",
  "git": {
    "deploymentEnabled": true
  },
  "rewrites": [
    { "source": "/demandas", "destination": "/index.html" },
    { "source": "/demandas/:path*", "destination": "/index.html" },
    { "source": "/minhas-demandas", "destination": "/index.html" },
    { "source": "/minhas-demandas/:path*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
