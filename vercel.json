{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "feat/expandir-modelo-central-trabalho-ciclo-3": true
    }
  },
  "rewrites": [
    { "source": "/demandas", "destination": "/index.html" },
    { "source": "/demandas/:path*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
