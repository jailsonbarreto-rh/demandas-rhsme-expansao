{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run check:docs && mkdir -p dist && printf '<!doctype html><title>R5-1 closure docs approved</title>' > dist/index.html",
  "git": { "deploymentEnabled": true },
  "rewrites": [
    { "source": "/demandas", "destination": "/index.html" },
    { "source": "/demandas/:path*", "destination": "/index.html" },
    { "source": "/minhas-demandas", "destination": "/index.html" },
    { "source": "/minhas-demandas/:path*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
